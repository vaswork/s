{
  "$schema": "https://json-schema.org",
  "$id": "https://vaswork.github.io/s/j/skrb/v1/cntmti.json",
  "title": "My Skarb Container Metadata",
  "description": "Расширенные метаданные физического контейнера или локации (v1.0)",
  "type": "object",
  "required": ["$schema", "environment"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "const": "https://vaswork.github.io/s/j/skrb/v1/cntmti.json"
    },
    "environment": {
      "type": "string",
      "enum": ["Indoor", "Outdoor"],
      "description": "Indoor — сухое отапливаемое помещение; Outdoor — балкон, гараж, сарай, подпол"
    },
    "packaging": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": ["Retail", "Upcycled", "Custom", "RoomZone"]
        },
        "vendor": {
          "type": "string",
          "description": "Например: Леруа Мерлен / Союзпак"
        },
        "is_upcycled": {
          "type": "boolean"
        },
        "original_product": {
          "type": "string",
          "description": "От чего коробка (например: Монитор Dell 27 или СВЧ-печь)"
        }
      },
      "additionalProperties": false
    },
    "dimensions_cm": {
      "type": "object",
      "required": ["length", "width", "height"],
      "properties": {
        "length": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "handling": {
      "type": "object",
      "properties": {
        "fragile": { "type": "boolean" },
        "stackable": { "type": "boolean" },
        "max_load_kg": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
